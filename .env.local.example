# 公開URL。sitemap / robots / OGP / 構造化データがこの値を参照する。
# lib/site.ts の既定値が本番ドメインなので、ローカルでは未設定でよい。
NEXT_PUBLIC_SITE_URL=https://drop-world.com

# サポート窓口のメールアドレス。Contact ページ・特商法ページ・フッターに表示される。
# ⚠ 実際に受信できる状態にすること（Cloudflare の Email Routing で転送するのが手軽）。
NEXT_PUBLIC_SUPPORT_EMAIL=support@drop-world.com

# Lemon Squeezy のストアURL（審査通過後に確定する）
NEXT_PUBLIC_LEMON_STORE_URL=https://drop-world.lemonsqueezy.com

# --- 以下は審査通過後に使う（今は未使用） ---
# LEMONSQUEEZY_API_KEY=
# LEMONSQUEEZY_STORE_ID=
