# ローカルでサイトを動かすとき用。コピーして .env.local にし、値を入れる（.env.local は Git に入らない）。

# Lemon Squeezy の API キー。
#   無ければ npm run dev は見本データ（content/lemon-fixture.json）で動く。
#   npm run build / preview / deploy はキーが無いと止まる（偽物のカタログを公開しないため）。
#   審査前はテストモードのキー、審査後は本番キー。
LEMONSQUEEZY_API_KEY=

# キーから見えるストアが複数あるときだけ指定
# LEMONSQUEEZY_STORE_ID=

# 公開 URL とサポート窓口（lib/site.ts の既定値と同じ。通常は変更不要）
NEXT_PUBLIC_SITE_URL=https://drop-world.com
NEXT_PUBLIC_SUPPORT_EMAIL=support@drop-world.com
