# 公開URL。sitemap / robots / OGP / 構造化データがこの値を参照する。
# 独自ドメインを繋いだらここを書き換える（Vercel 側の環境変数も同様に更新）。
NEXT_PUBLIC_SITE_URL=https://dropworld.vercel.app

# サポート窓口のメールアドレス。Contact ページと法務ページに表示される。
NEXT_PUBLIC_SUPPORT_EMAIL=support@dropworld.example

# Lemon Squeezy のストアURL（審査通過後に確定する）
NEXT_PUBLIC_LEMON_STORE_URL=https://dropworld.lemonsqueezy.com

# --- 以下は審査通過後に使う（今は未使用） ---
# LEMONSQUEEZY_API_KEY=
# LEMONSQUEEZY_STORE_ID=
