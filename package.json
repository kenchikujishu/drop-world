{
  "name": "drop-world",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node --env-file-if-exists=.env.local scripts/lemon-sync.mjs --dev && next dev",
    "build": "node --env-file-if-exists=.env.local scripts/lemon-sync.mjs && next build",
    "lint": "next lint",
    "lemon:check": "node --env-file-if-exists=.env.local scripts/lemon-sync.mjs --check",
    "export:thumbs": "node scripts/export-thumbnails.mjs",
    "cf:build": "opennextjs-cloudflare build",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "^1.20.2",
    "next": "^15.5.23",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.14.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "eslint": "^8.57.0",
    "eslint-config-next": "^15.5.23",
    "typescript": "^5.4.5",
    "wrangler": "^4.123.0"
  }
}
