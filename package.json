{
  "name": "drop-world",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "npm run validate:products && next build",
    "lint": "next lint",
    "new:product": "node scripts/new-product.mjs",
    "validate:products": "node scripts/validate-products.mjs",
    "cf:build": "npm run validate:products && opennextjs-cloudflare build",
    "preview": "npm run cf:build && opennextjs-cloudflare preview",
    "deploy": "npm run cf:build && opennextjs-cloudflare deploy",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "^1.20.2",
    "next": "^15.5.23",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.14.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "eslint": "^8.57.0",
    "eslint-config-next": "^15.5.23",
    "typescript": "^5.4.5",
    "wrangler": "^4.123.0"
  }
}
